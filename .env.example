# --- LLM (models & presets: backend/config/llm.yaml) ---
OPENROUTER_API_KEY=
# LLM_PRESET=budget        # budget | balanced | claude | gemini | claude_direct
ANTHROPIC_API_KEY=          # only for the claude_direct preset

# --- infra (compose service names) ---
DATABASE_URL=postgresql+psycopg://mra:mra@postgres:5432/mra
REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URI=redis://redis:6379/1
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=change-me-to-a-long-random-string

# --- app ---
APP_ENV=dev
LOG_LEVEL=INFO
# Set true only behind our reverse proxy (it appends the real client IP to X-Forwarded-For).
TRUST_PROXY=false
IP_HASH_SALT=change-me
REVIEW_RATE_LIMIT=5/hour          # anonymous callers, per IP
API_KEY_RATE_LIMIT=60/hour        # callers with an API key (python -m app.cli.keys mint ...)
PAPER_SEARCH_RATE_LIMIT=30/minute # /papers/search and the MCP search tool
MAX_CONCURRENT_REVIEWS_PER_WORKER=2

# --- review pipeline (Plan 2) ---
GRAPH_MODE=real
# Papers are read from their abstracts only (no full-text fetching or crawling).
LLM_CONCURRENCY=16                # max LLM requests in flight per worker process

# --- integrations (Plan 3) ---
PUBLIC_BASE_URL=http://localhost:8000   # used in webhook result_url and MCP links
# Host headers accepted by /mcp (DNS-rebinding protection). Add your public domain in production.
MCP_ALLOWED_HOSTS=["localhost","localhost:*","127.0.0.1:*","api:*"]
WEBHOOK_ALLOW_HTTP=false                # true only for local webhook testing
# External MCP servers the agent may consult: backend/config/mcp_servers.json
