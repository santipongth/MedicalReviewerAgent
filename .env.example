# --- LLM ---
ANTHROPIC_API_KEY=
CONTACT_EMAIL=you@example.com

# --- infra (compose service names) ---
DATABASE_URL=postgresql+psycopg://mra:mra@postgres:5432/mra
REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URI=redis://redis:6379/1
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=change-me-to-a-long-random-string

# --- app ---
APP_ENV=dev
LOG_LEVEL=INFO
# Set true only behind our reverse proxy (it appends the real client IP to X-Forwarded-For).
TRUST_PROXY=false
IP_HASH_SALT=change-me
REVIEW_RATE_LIMIT=5/hour
MAX_CONCURRENT_REVIEWS_PER_WORKER=2

# --- review pipeline (Plan 2) ---
GRAPH_MODE=real
GUARD_MODEL=claude-haiku-4-5
PLANNER_MODEL=claude-sonnet-5-5
SCREEN_MODEL=claude-haiku-4-5
EXTRACT_MODEL=claude-sonnet-5-5
SYNTHESIZE_MODEL=claude-opus-5-5
SYNTHESIZE_EFFORT=high
# --- full text crawling (Crawl4AI service; generate with: openssl rand -hex 32) ---
CRAWL4AI_API_TOKEN=change-me-generate-a-random-token
CRAWL4AI_URL=http://crawl4ai:11235
CRAWL_STEALTH=true
