# --- LLM (models & presets: backend/config/llm.yaml; llm.yaml and LLM_PRESET apply until a version is saved in the admin console) ---
OPENROUTER_API_KEY=         # a key entered in the admin console (/admin/models, "ผู้ให้บริการและคีย์") overrides this one
# LLM_PRESET=budget        # budget | balanced | claude | gemini | claude_direct (no effect once a version is saved in the admin console)
ANTHROPIC_API_KEY=          # only for the claude_direct preset
# Plan 23e: the master key that encrypts provider keys entered in the admin console. Without it the console cannot
# store keys (env keys still work). Generate: docker compose run --rm api python -m app.cli.admin llm-keys-secret
# (or: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"). Comma-separate a new
# key in front of the old one to rotate (then run app.cli.admin rotate-llm-keys). Keep a backup of this file: losing it
# makes the stored keys unreadable.
LLM_KEYS_SECRET=
# A provider with a free name (e.g. deepseek) may also take its key from env, bound to its origin:
# LLM_KEY_DEEPSEEK=
# LLM_KEY_DEEPSEEK_ORIGIN=https://api.deepseek.com

# --- infra (compose service names) ---
DATABASE_URL=postgresql+psycopg://mra:mra@postgres:5432/mra
REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URI=redis://redis:6379/1
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=change-me-to-a-long-random-string
# Host port docker publishes SearXNG on (127.0.0.1 only; for a backend run outside docker). Change it when 8080 is taken.
SEARXNG_HOST_PORT=8080
# Optional academic API keys, passed to the searxng container only (infra/searxng/engines). Leave empty
# to run keyless; every engine still works, with the provider's shared/anonymous limits.
# PubMed E-utilities: 10 req/s instead of 3 (free, NCBI account settings)
NCBI_API_KEY=
# OpenAlex: keyless use is metered (~$0.10/day); a free key raises the daily budget
OPENALEX_API_KEY=
# OpenAlex contact email (polite pool); also used by the backend's citation lookups. Optional.
OPENALEX_MAILTO=
# Semantic Scholar: switches to the official Graph API with a dedicated rate limit
S2_API_KEY=
# CORE: reserved for the fork's `core` engine (not enabled yet)
CORE_API_KEY=
# SearXNG engines the backend queries (names from infra/searxng/settings.yml). Default below; append ",plos" to opt in
# to PLOS (10 req/min, 300/h budget). The admin console (/admin/sources) can turn each engine off or on; a saved version
# there overrides individual sources, while this list still supplies the defaults and any extra engines the console
# does not list. The web UI's source list follows GET /api/v1/status.
# SEARXNG_ENGINES=pubmed,europe pmc,openalex,semantic scholar,crossref,arxiv,doaj,openaire
# ThaiJO (Thai Journals Online, Plan 24): Thai health journals as an extra source. ON by default since 2026-10-13 (owner's
# decision); set THAIJO_ENABLED=false to turn it off (/admin/sources in the console wins over this flag). TCI's search API
# is undocumented: a letter to TCI is recommended.
# At most 15 candidates per review (and at most 1/8 of the pool); abstracts and OAI records cached 7 days in Redis.
# THAIJO_ENABLED=false

# --- app ---
APP_ENV=dev
LOG_LEVEL=INFO
# Set true only behind our reverse proxy (it appends the real client IP to X-Forwarded-For).
TRUST_PROXY=false
IP_HASH_SALT=change-me
REVIEW_RATE_LIMIT=5/hour          # anonymous callers, per IP
API_KEY_RATE_LIMIT=60/hour        # callers with an API key (python -m app.cli.keys mint ...)
PAPER_SEARCH_RATE_LIMIT=30/minute # /papers/search and the MCP search tool
MAX_CONCURRENT_REVIEWS_PER_WORKER=4  # reviews per worker process
# --- capacity & scaling (Plan 7) ---
API_WORKERS=2                     # uvicorn processes in the api container
WORKER_REPLICAS=1                 # worker containers (docker compose)
MAX_QUEUED_REVIEWS=50             # 503 + Retry-After once this many reviews wait
MAX_REVIEWS_PER_DAY=500           # all callers, resets 00:00 UTC
MAX_USD_PER_DAY=10                # LLM spend, resets 00:00 UTC
MAX_COST_PER_REVIEW_USD=0.25      # remaining LLM steps are skipped beyond this
# HARNESS_MAX_USD=5              # most a console harness run may be capped at (Plan 23c; env only)
SSE_MAX_PER_IP=5                  # open event streams per client
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Cloudflare Turnstile for anonymous web submissions; leave empty to disable (dev)
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
# --- single public origin (Caddy, infra/caddy/Caddyfile) ---
PUBLIC_PORT=8088                  # host port of the Caddy front
SITE_ADDRESS=:80                  # your domain for automatic HTTPS in production
# Production: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d (publishes only Caddy and sets
# PUBLIC_API_URL=/ and TRUST_PROXY=true). TRUST_PROXY must stay false while api:8000 is reachable directly.
# PUBLIC_API_URL=/
# Server-side address the web app uses to fetch a review for the offline HTML report (compose sets
# http://api:8000). Needed whenever PUBLIC_API_URL is not an absolute URL the web server itself can reach.
# INTERNAL_API_URL=http://api:8000

# --- review pipeline (Plan 2) ---
GRAPH_MODE=real
# Papers are read from their abstracts only (no full-text fetching or crawling).
LLM_CONCURRENCY=16                # max LLM requests in flight per worker process

# --- integrations (Plan 3) ---
# Production: https://your.domain. It also makes the admin console's cookie Secure.
PUBLIC_BASE_URL=http://localhost:8000   # used in webhook result_url and MCP links
# The admin cookie is Secure automatically on https (PUBLIC_BASE_URL, or X-Forwarded-Proto from Caddy when
# TRUST_PROXY=true). Uncomment only to force it on or off; an empty value fails settings validation.
# ADMIN_COOKIE_SECURE=true
# Host headers accepted by /mcp (DNS-rebinding protection). Add your public domain in production.
MCP_ALLOWED_HOSTS=["localhost","localhost:*","127.0.0.1:*","api:*"]
WEBHOOK_ALLOW_HTTP=false                # true only for local webhook testing
# External MCP servers the agent may consult: backend/config/mcp_servers.json
